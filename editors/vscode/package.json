{
  "name": "phplumb",
  "displayName": "PHPlumb",
  "description": "Fast code navigation for large PHP and Drupal codebases.",
  "publisher": "sparkfabrik",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:php",
    "workspaceContains:**/*.php"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "php",
        "extensions": [
          ".module",
          ".inc",
          ".install",
          ".theme",
          ".profile",
          ".engine"
        ]
      }
    ],
    "configuration": {
      "title": "PHPlumb",
      "properties": {
        "phplumb.server.path": {
          "type": "string",
          "default": "",
          "description": "Path of the phplumb binary. Empty uses the bundled binary."
        },
        "phplumb.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns, relative to the workspace folder, of paths not to index."
        },
        "phplumb.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Reports classes, functions, methods and constants that do not exist, in project code (outside vendor, core and contrib)."
        },
        "phplumb.frameworks.drupal": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "Drupal support, such as types for services. auto turns it on when composer.lock requires drupal/core."
        },
        "phplumb.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the phplumb server."
        }
      }
    },
    "commands": [
      {
        "command": "phplumb.restartServer",
        "title": "PHPlumb: Restart Server"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "vscode-test",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  }
}
